# The title of the app; in production, should be the name of the game
VITE_APP_TITLE="cardgame-client"

# Base URL for a remote API; if not set, configures proxy rules with defaults
# in `vite.config.ts``
VITE_API_BASE_URL=

# The public origin of the deployed site, with no trailing path, e.g.
# "https://example.com". Required for canonical URLs; when unset, no canonical
# is published. Do not set this for preview deployments.
VITE_SITE_URL=

{
  "name": "cardgame-server",
  "private": true,
  "version": "0.0.1",
  "description": "Server-side logic for strategy based card game.",
  "author": "Steven Lewis",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:public": "vitest run --config vitest.config.ts public",
    "test:watch": "vitest --config vitest.config.ts",
    "build": "tsc --build && tsc-alias -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "dev": "ts-node -r tsconfig-paths/register src/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-slow-down": "^3.0.1",
    "mongodb": "^7.0.0",
    "pino": "^10.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3",
    "vitest": "^4.0.18"
  }
}
